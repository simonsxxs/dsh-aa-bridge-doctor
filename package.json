{
  "name": "dsh-aa-bridge-doctor",
  "version": "0.1.0",
  "description": "Detect and auto-recover Agents Anywhere bridge wedge (persistent device offline) for DeepSeek Harness",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/simonsxxs/dsh-aa-bridge-doctor.git"
  },
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.host.json",
    "typecheck": "tsc -p tsconfig.host.json --noEmit",
    "test": "tsx --test tests/unit/*.test.ts",
    "smoke:apply": "tsx scripts/smoke-apply.mjs",
    "smoke:heal": "tsx scripts/smoke-heal.mjs",
    "check": "npm run typecheck && npm run build && npm run test",
    "rc": "npm run check && npm run smoke:apply && npm run smoke:heal && npm run smoke:cordis && npm pack --dry-run",
    "prepublishOnly": "npm run check && npm pack --dry-run",
    "smoke:cordis": "tsx scripts/smoke-cordis.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4 || ~4.1.0",
    "@deepseek-ai/schemastery": "~3.18.4 || ~3.19.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/schemastery": "3.19.0",
    "@types/node": "^24.13.3",
    "tsx": "4.21.0",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": "^22.19.0 || >=24"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "license": "MIT",
  "author": "simon，一个不懂代码的 AI 极客 <simonsxx@qq.com> (https://simonsxx.com)",
  "keywords": [
    "deepseek-harness",
    "agents-anywhere",
    "dsh-plugin",
    "watchdog",
    "self-healing",
    "bridge-doctor"
  ]
}
